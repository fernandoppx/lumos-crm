# GEMINI_API_KEY: Injetada automaticamente pelo AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde a aplicação está hospedada (ex: https://meu-crm.run.app)
APP_URL="MY_APP_URL"

# Evolution API - Integração WhatsApp por QR Code
# URL base da sua instância da Evolution API (ex: https://evolution.suaempresa.com.br ou http://localhost:8080)
EVOLUTION_API_URL=""

# Chave Global ou de Instância da Evolution API (enviada no header apikey)
EVOLUTION_API_KEY=""

# Nome da instância criada na Evolution API (ex: lumus-comercial)
EVOLUTION_INSTANCE_NAME=""

# Segredo compartilhado para validação das requisições de webhook enviadas pela Evolution API
WEBHOOK_SECRET=""
