# Endereço público do CRM (usado para configurar o webhook de cada número)
# Na Vercel, se ficar vazio, o CRM usa o domínio de produção automaticamente.
APP_URL="https://lumos-crm-steel.vercel.app"

# Evolution API (servidor que mantém os WhatsApps conectados)
EVOLUTION_API_URL="https://evolution.suaempresa.com.br"
# Chave global da Evolution (AUTHENTICATION_API_KEY no servidor da Evolution)
EVOLUTION_API_KEY=""

# Segredo que a Evolution envia junto com cada evento. Invente um texto longo e aleatório.
WEBHOOK_SECRET=""

# JSON da conta de serviço do Firebase, em uma linha.
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_KEY=''

# Opcional: limite de números de WhatsApp (padrão 10)
MAX_WHATSAPP_INSTANCES=10

# Opcional (versão antiga): nome de uma instância que já existia na Evolution.
# Ela aparece no CRM como "Número principal" quando chegar o primeiro evento.
EVOLUTION_INSTANCE_NAME=""
